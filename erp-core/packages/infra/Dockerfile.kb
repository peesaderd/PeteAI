FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json ./
COPY packages/knowledge-base/package.json ./packages/knowledge-base/
RUN npm install
COPY . .
RUN npm run build -w packages/knowledge-base

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/packages/knowledge-base/dist ./dist
COPY --from=builder /app/packages/knowledge-base/package.json ./
RUN npm install --production
EXPOSE 3100
CMD ["node", "dist/index.js"]
