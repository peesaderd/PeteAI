FROM node:20-alpine AS builder
WORKDIR /app
COPY packages/knowledge-base/package.json packages/knowledge-base/tsconfig.json ./ 
RUN npm install
COPY packages/knowledge-base/src ./src
RUN npx tsc

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY packages/knowledge-base/package.json ./
EXPOSE 3100
CMD ["node", "dist/index.js"]
